+"""Machine authentication at the real management HTTP entrance."""
+
+import asyncio
+import json
+import subprocess
+import sys
+import unittest
+
+from flask import Flask
+
+from sendspin_bridge.web.routes.api_output import create_output_blueprint
+from tests.test_output_preparation import PhysicalOutput
+
+
+class OutputHttpTests(unittest.IsolatedAsyncioTestCase):
+    def make_app(self, config, outputs=None):
+        app = Flask(__name__)
+        loop = asyncio.get_running_loop()
+        app.register_blueprint(create_output_blueprint(
+            config_provider=lambda: config, outputs_provider=lambda: outputs or {},
+            loop_provider=lambda: loop))
+        return app
+
+    async def test_http_prepare_and_release_use_the_known_nonce_contract(self):
+        output = PhysicalOutput()
+        app = self.make_app({"OUTPUT_PREPARATION_ENABLED": True,
+                             "OUTPUT_PREPARATION_TOKEN": "machine-secret"}, {"configured-player": output})
+        client = app.test_client()
+        headers = {"X-Output-Preparation-Token": "machine-secret"}
+        body = {"output_id": "configured-player", "lease_id": "intent-1", "timeout_seconds": 1}
+        response = await asyncio.to_thread(client.post, "/api/output/prepare", json=body, headers=headers)
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json["status"], "ready")
+        self.assertEqual(response.json["lease_id"], "intent-1")
+        self.assertTrue(response.json["output_epoch"])
+        response = await asyncio.to_thread(client.post, "/api/output/release",
+                                          json={"output_id": "configured-player", "lease_id": "intent-1", "reason": "stop"},
+                                          headers=headers)
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json, {"status": "released", "output_id": "configured-player", "lease_id": "intent-1"})
+        response = await asyncio.to_thread(client.post, "/api/output/prepare", json=body, headers=headers)
+        self.assertEqual(response.status_code, 409)
+        self.assertEqual(response.json["error"], "cancelled")
+
+    async def test_failed_release_cancels_a_prepare_that_has_not_arrived(self):
+        output = PhysicalOutput()
+        app = self.make_app({"OUTPUT_PREPARATION_ENABLED": True,
+                             "OUTPUT_PREPARATION_TOKEN": "machine-secret"}, {"configured-player": output})
+        client = app.test_client()
+        headers = {"X-Output-Preparation-Token": "machine-secret"}
+        response = await asyncio.to_thread(client.post, "/api/output/release",
+                                          json={"output_id": "configured-player", "lease_id": "failed-intent", "reason": "failed"},
+                                          headers=headers)
+        self.assertEqual(response.status_code, 200)
+        response = await asyncio.to_thread(client.post, "/api/output/prepare",
+                                          json={"output_id": "configured-player", "lease_id": "failed-intent", "timeout_seconds": 1},
+                                          headers=headers)
+        self.assertEqual(response.status_code, 409)
+        self.assertEqual(response.json["error"], "cancelled")
+        self.assertEqual(output.prepares, [])
+
+    async def test_http_rejects_unknown_output_and_unbounded_deadlines(self):
+        output = PhysicalOutput()
+        app = self.make_app({"OUTPUT_PREPARATION_ENABLED": True,
+                             "OUTPUT_PREPARATION_TOKEN": "machine-secret"}, {"configured-player": output})
+        headers = {"X-Output-Preparation-Token": "machine-secret"}
+        for timeout in (None, True, -1, 0, "1", float("inf"), float("nan"), 16):
+            response = await asyncio.to_thread(app.test_client().post, "/api/output/prepare",
+                                              json={"output_id": "configured-player", "lease_id": "intent", "timeout_seconds": timeout},
+                                              headers=headers)
+            self.assertEqual(response.status_code, 400, timeout)
+        response = await asyncio.to_thread(app.test_client().post, "/api/output/prepare",
+                                          json={"output_id": "AA:BB:CC:DD:EE:FF", "lease_id": "intent", "timeout_seconds": 1},
+                                          headers=headers)
+        self.assertEqual(response.status_code, 404)
+        self.assertEqual(output.prepares, [])
+
+    async def test_release_rejects_non_string_reason_as_a_client_error(self):
+        app = self.make_app({"OUTPUT_PREPARATION_ENABLED": True, "OUTPUT_PREPARATION_TOKEN": "machine-secret"})
+        response = app.test_client().post("/api/output/release",
+                                          json={"output_id": "configured-player", "lease_id": "intent", "reason": []},
+                                          headers={"X-Output-Preparation-Token": "machine-secret"})
+        self.assertEqual(response.status_code, 400)
