+            self._leases[output_id] = lease
+            lease.task = self._track(self._prepare(output_id, lease))
+        try:
+            if lease.result.done() and lease.result.exception() is None:
+                try:
+                    valid = await asyncio.wait_for(lease.output.validate_binding(lease.epoch), self._timeout_seconds)
+                except Exception:
+                    valid = False
+                if not valid or self._leases.get(output_id) is not lease:
+                    await self.release(output_id, lease_id, "output_unavailable")
+                    raise PreparationError("output_unavailable")
+            done, _ = await asyncio.wait({lease.result}, timeout=max(0, lease.deadline - self._clock()))
+            if not done:
+                await self.release(output_id, lease_id, "timeout")
+                raise PreparationError("timeout")
+            if lease.revoked or self._leases.get(output_id) is not lease:
+                raise PreparationError(lease.revoked or "superseded")
+            result = dict(lease.result.result())
+            if lease.pcm_format is not None:
+                result["pcm_format"] = lease.pcm_format.as_dict()
+            return result
+        except asyncio.CancelledError:
+            await self.release(output_id, lease_id, "cancelled")
+            raise
+
+    async def _prepare(self, output_id, lease):
+        try:
+            binding = (await lease.output.prepare(lease.epoch, pcm_format=lease.pcm_format)
+                       if lease.pcm_format is not None else await lease.output.prepare(lease.epoch))
+            if lease.revoked or self._leases.get(output_id) is not lease:
+                return
+            if binding.epoch != lease.epoch or not binding.ready:
+                raise PreparationError("output_unavailable")
+            lease.result.set_result(
+                {"status": "ready", "output_id": output_id, "lease_id": lease.lease_id, "output_epoch": lease.epoch}
+            )
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            if self._leases.get(output_id) is lease:
+                code = exc.code if isinstance(exc, PreparationError) else "output_unavailable"
+                await self.release(output_id, lease.lease_id, code)
