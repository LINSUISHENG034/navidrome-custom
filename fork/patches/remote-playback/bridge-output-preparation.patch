+    async def run_cold_output_daemon(self, commands, *, content=False, enabled=True, backend_visible=True,
+                                     allocation_error=False):
+        # The pinned SDK handler/client/player remain real. Only the external
+        # PortAudio/PulseAudio ports are substituted; there is no owned stream
+        # until the SDK actually allocates its output backend.
+        script = r'''
+import asyncio
+import json
+import os
+import sys
+from types import SimpleNamespace
+from unittest.mock import patch
+import sounddevice
+from aiosendspin.client import AudioFormat, PCMFormat
+from aiosendspin.models.player import SupportedAudioFormat
+from aiosendspin.models.types import AudioCodec
+from sendspin.audio_devices import AudioDevice
+from sendspin.audio_connector import AudioStreamHandler
+from sendspin.daemon.daemon import DaemonArgs
+from sendspin_bridge.services.audio import pulse
+from sendspin_bridge.services.ipc import daemon_process
+from sendspin_bridge.services.ipc.bridge_daemon import BridgeDaemon
+from tests.test_output_preparation import PulseOutput, SdkBackendPort, SdkTransport
+fixture = json.loads(sys.argv[1])
+external = PulseOutput()
+external.streams = [external.unrelated]
+external.unrelated.proplist["application.process.id"] = str(os.getpid())
+os.environ["PULSE_PROP_application.name"] = "sendspin-owned-player"
+os.environ["PULSE_PROP_OVERRIDE_application.name"] = "sendspin-owned-player"
+os.environ["PULSE_SINK"] = "sendspin_fallback"
+backend = SdkBackendPort()
+def opened(stream):
+    stream.index = 100 + len(backend.streams)
+    stream.sink = 6 if os.environ["PULSE_SINK"] == "configured-sink" else 0
+    stream.proplist = {"application.process.id": str(os.getpid()),
+                      "application.name": os.environ["PULSE_PROP_OVERRIDE_application.name"]}
+    if fixture["backend_visible"]:
+        external.streams.append(stream)
+def closed(stream):
+    if stream in external.streams:
+        external.streams.remove(stream)
+def opening():
+    if fixture["allocation_error"]:
+        raise OSError("External audio backend unavailable")
+backend.on_open, backend.on_close, backend.before_open = opened, closed, opening
+async def main():
+    device = AudioDevice(index=1, name="pulse", output_channels=2, sample_rate=48000, is_default=True)
+    preferred = SupportedAudioFormat(codec=AudioCodec.PCM, sample_rate=48000, channels=2, bit_depth=16)
+    args = DaemonArgs(audio_device=device, client_id="owned-player", client_name="configured-player",
+                      settings=SimpleNamespace(player_volume=100, player_muted=False), preferred_format=preferred)
+    status, feed_task = {}, None
+    async def feed_content():
+        content_format = AudioFormat(AudioCodec.PCM, PCMFormat(sample_rate=48000, channels=2, bit_depth=16))
+        source = bytes(range(64)) * 1600
+        packets = [(source, 500000)]
+        if fixture["content"] == "flac":
+            from aiosendspin.server.roles.player.audio_transformers import FlacEncoder
+            encoder = FlacEncoder(sample_rate=48000, channels=2, bit_depth=16)
+            packets = encoder.process(source, daemon._client.timestamp, 500000) + encoder.flush()
+            content_format = AudioFormat(AudioCodec.FLAC, content_format.pcm_format, encoder.get_header())
+        daemon._client.emit_start(content_format)
+        timestamp = daemon._client.timestamp
+        for packet, duration in packets:
+            daemon._client.emit_audio(packet, content_format, timestamp)
+            timestamp += duration
+        if not await asyncio.to_thread(backend.started.wait, 2):
+            raise RuntimeError("Real content SDK output did not start")
+        print(json.dumps({"content_snapshot": True, "allocations": len(backend.streams),
+                          "closes": sum(stream.closed for stream in backend.streams),
+                          "owned_streams": len(external.streams) - 1,
+                          "output_samples": [sample.hex() for stream in backend.streams for sample in stream.samples]}), flush=True)
+    def notify():
+        nonlocal feed_task
+        daemon_process._emit_status(status)
+        if fixture["content"] and status.get("output_binding_ready") and feed_task is None:
+            feed_task = asyncio.create_task(feed_content())
+    daemon = BridgeDaemon(args, status, "configured-sink", on_status_change=notify)
+    handler = AudioStreamHandler(device, on_format_change=daemon._handle_format_change, on_event=daemon._on_stream_event)
+    daemon._audio_handler = handler
+    daemon._client = SdkTransport() if fixture["content"] else daemon._create_client()
+    handler.attach_client(daemon._client)
+    print(json.dumps({"cold_owned_streams": len(external.streams) - 1}), flush=True)
+    try:
+        await daemon_process._read_commands([daemon], asyncio.Event(), bt_sink_name="configured-sink",
+                                            prepared_output=fixture["enabled"])
+        if feed_task is not None:
+            await feed_task
+    finally:
+        await handler.shutdown()
+with patch.object(sounddevice, "RawOutputStream", side_effect=backend.open), \
+        patch.object(sounddevice, "check_output_settings", return_value=None), \
+        patch.object(pulse.pulsectl_asyncio, "PulseAsync", side_effect=lambda name: external):
+    asyncio.run(main())
+print(json.dumps({"allocations": [stream.settings["device"] for stream in backend.streams],
+                  "settings": [{key: stream.settings[key] for key in ("samplerate", "channels", "dtype")} for stream in backend.streams],
+                  "starts": [True for stream in backend.streams if stream.samples],
+                  "closes": [True for stream in backend.streams if stream.closed],
+                  "owned_streams": len(external.streams) - 1, "unrelated_sink": external.unrelated.sink}))
+'''
+        process = await asyncio.create_subprocess_exec(
+            sys.executable, "-B", "-c", script, json.dumps({"content": content, "enabled": enabled,
+                                                          "backend_visible": backend_visible,
+                                                          "allocation_error": allocation_error}),
+            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
+        prefix = b""
+        try:
+            process.stdin.write("".join(json.dumps(command) + "\n" for command in commands).encode())
+            await process.stdin.drain()
+            if content:
+                while b'"content_snapshot": true' not in prefix:
+                    line = await asyncio.wait_for(process.stdout.readline(), timeout=5)
+                    if not line:
+                        raise AssertionError("Cold daemon exited before content handoff: " + prefix.decode())
+                    prefix += line
