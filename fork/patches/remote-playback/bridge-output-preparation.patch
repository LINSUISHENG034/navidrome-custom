index 0000000000000000000000000000000000000000..9f38a7d9317700eb5e4a004122e0bc3503070d98
--- /dev/null
+++ b/src/sendspin_bridge/bridge/output_preparation.py
@@ -0,0 +1,182 @@
+"""Cancellable ownership of configured physical outputs, independent of music."""
+
+from __future__ import annotations
+
+import asyncio
+import math
+import secrets
+import time
+from dataclasses import dataclass
+from typing import Protocol
+
+__all__ = ["OutputBinding", "OutputPreparation", "PhysicalOutput", "PreparationError"]
+
+
+@dataclass(frozen=True)
+class OutputBinding:
+    epoch: str
+    connected: bool
+    profile_ready: bool
+    sink_ready: bool
+    daemon_ready: bool
+    backend_bound: bool
+
+    @property
+    def ready(self) -> bool:
+        return all((self.connected, self.profile_ready, self.sink_ready, self.daemon_ready, self.backend_bound))
+
+
+class PhysicalOutput(Protocol):
+    async def prepare(self, epoch: str) -> OutputBinding: ...
+    async def release(self, epoch: str) -> None: ...
+    async def validate_binding(self, epoch: str) -> bool: ...
+
+
+class PreparationError(Exception):
+    def __init__(self, code: str):
+        super().__init__(code)
+        self.code = code
+
+
+@dataclass
+class _Lease:
+    lease_id: str
+    epoch: str
+    output: PhysicalOutput
+    result: asyncio.Future
+    deadline: float
+    task: asyncio.Task | None = None
+    revoked: str | None = None
+
+
+class OutputPreparation:
+    """One current intent per output; callers never own Bluetooth operation leases.
+
+    Cancellation records reserve space while an intent is live. At capacity,
+    fail closed rather than forgetting a recent cancellation. The configured
+    TTL is the replay-protection horizon; callers must never reuse lease IDs.
+    All methods run on the bridge's existing asyncio loop.
