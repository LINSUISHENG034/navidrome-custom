+    def emit_start(self, audio_format):
+        from aiosendspin.models.core import StreamStartMessage, StreamStartPayload, StreamStartPlayer
+
+        pcm = audio_format.pcm_format
+        import base64
+
+        header = base64.b64encode(audio_format.codec_header).decode() if audio_format.codec_header else None
+        message = StreamStartMessage(StreamStartPayload(player=StreamStartPlayer(
+            codec=audio_format.codec, sample_rate=pcm.sample_rate, channels=pcm.channels, bit_depth=pcm.bit_depth,
+            codec_header=header,
+        )))
+        for callback in tuple(self.callbacks["start"]):
+            callback(message)
+
+    def emit_audio(self, payload, audio_format, timestamp=None):
+        self.chunks_sent += 1
+        for callback in tuple(self.callbacks["chunk"]):
+            callback(self.timestamp if timestamp is None else timestamp, payload, audio_format)
+
+    def emit_end(self):
+        for callback in tuple(self.callbacks["end"]):
+            callback(["player"])
+
+    def emit_clear(self):
+        for callback in tuple(self.callbacks["clear"]):
+            callback(["player"])
