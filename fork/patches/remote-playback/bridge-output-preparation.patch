+    async def test_registered_management_route_never_uses_web_or_ingress_auth(self):
+        # A fresh interpreter keeps the real application's import-time config
+        # and registered blueprints isolated from sibling pytest test files.
+        script = '''
+import json
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from unittest.mock import patch
+from sendspin_bridge.config import DEFAULT_CONFIG
+config = {**DEFAULT_CONFIG, "SECRET_KEY": "isolated-test-secret", "AUTH_ENABLED": True,
+          "OUTPUT_PREPARATION_ENABLED": True, "OUTPUT_PREPARATION_TOKEN": "machine-secret"}
+with patch("sendspin_bridge.config.load_config", side_effect=lambda: dict(config)):
+    from sendspin_bridge.web.interface import app
+    client = app.test_client()
+    with client.session_transaction() as session:
+        session["authenticated"] = True
+    response = client.post("/api/output/prepare", json={}, headers={"X-Ingress-Path": "/trusted"})
+    assert response.status_code == 401, response.status_code
+    response = client.post("/api/output/prepare", json={}, headers={"X-Output-Preparation-Token": "machine-secret"})
+    assert response.status_code == 400, response.status_code
+    response = client.get("/api/config")
+    assert response.status_code == 200, response.status_code
+    assert "machine-secret" not in response.get_data(as_text=True), "machine credential exposed by config GET"
+    with TemporaryDirectory() as directory:
+        config_file = Path(directory) / "config.json"
+        config_file.write_text(json.dumps(config))
+        with patch("sendspin_bridge.web.routes.api_config.CONFIG_FILE", config_file):
+            response = client.get("/api/config/download")
+            assert response.status_code == 200, response.status_code
+            assert "machine-secret" not in response.get_data(as_text=True), "machine credential exposed by config download"
+'''
+        result = await asyncio.to_thread(subprocess.run, [sys.executable, "-B", "-c", script],
+                                         capture_output=True, text=True, timeout=5)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    async def run_output_daemon(self, commands, *, streaming=False):
+        # Keep BridgeDaemon and stdin/stdout dispatch real; replace only the
+        # external SDK lifetime, audio device discovery, and PulseAudio ports.
+        script = r'''
+import asyncio
+import json
+import os
+import sys
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+from sendspin.daemon.daemon import SendspinDaemon
+from sendspin_bridge.services.audio import pulse
+from sendspin_bridge.services.ipc import daemon_process
+from tests.test_output_preparation import PulseOutput
+external = PulseOutput()
+for stream in external.streams:
+    stream.proplist["application.process.id"] = str(os.getpid())
+os.environ["PULSE_PROP_application.name"] = "sendspin-owned-player"
+device = SimpleNamespace(name="pulse", index=1, is_default=True)
+def sdk_init(self, args):
+    self._args = args
+    self._audio_handler = None
+    self._client = None
+async def sdk_run(self):
+    if json.loads(sys.argv[1]).get("fixture_streaming"):
+        self._handle_format_change("pcm", 44100, 16, 2)
+    await asyncio.Event().wait()
+with patch.object(SendspinDaemon, "__init__", sdk_init), \
+        patch.object(SendspinDaemon, "run", sdk_run), \
+        patch.object(SendspinDaemon, "_handle_format_change", lambda *args: None), \
+        patch("sendspin.audio_devices.query_devices", return_value=[device]), \
+        patch("sendspin.settings.get_client_settings", new=AsyncMock(return_value=SimpleNamespace(player_volume=100))), \
+        patch.object(pulse.pulsectl_asyncio, "PulseAsync", side_effect=lambda name: external):
+    daemon_process.main()
+print(json.dumps({"test_moves": external.moves, "unrelated_sink": external.unrelated.sink}))
+'''
+        params = {"player_name": "configured-player", "client_id": "owned-player", "listen_port": 8928,
+                  "bluetooth_sink_name": "sendspin_fallback", "output_preparation_enabled": True,
+                  "fixture_streaming": streaming}
+        def execute():
+            import os
+            import select
+            from time import monotonic, sleep
+            args = [sys.executable, "-B", "-c", script, json.dumps(params)]
+            with subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                  stderr=subprocess.PIPE, text=True) as process:
+                content = "".join(json.dumps(command) + "\n" for command in commands)
+                prefix = ""
+                try:
+                    if streaming:
+                        process.stdin.write(content)
+                        process.stdin.flush()
+                        deadline = monotonic() + 10
+                        while '"output_binding_ready": true' not in prefix:
+                            readable, _, _ = select.select([process.stdout], [], [], max(0, deadline - monotonic()))
+                            if not readable:
+                                raise TimeoutError("daemon did not publish binding readiness")
+                            chunk = os.read(process.stdout.fileno(), 65536)
+                            if not chunk:
+                                raise AssertionError("daemon exited before binding readiness: " + prefix)
+                            prefix += chunk.decode()
+                        # After readiness, give the real 0.5-second watcher two
+                        # observations while stdin remains open.
+                        sleep(1.2)
+                        content = ""
+                    stdout, stderr = process.communicate(content + json.dumps({"cmd": "stop"}) + "\n", timeout=10)
+                except Exception:
+                    process.kill()
+                    process.communicate()
+                    raise
+                return subprocess.CompletedProcess(args, process.returncode, prefix + stdout, stderr)
+        result = await asyncio.to_thread(execute)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        messages = [json.loads(line) for line in result.stdout.splitlines() if line.startswith("{")]
+        return messages, result.stdout + result.stderr
+
+    async def test_daemon_stdin_binding_reports_ready_without_touching_unrelated_streams(self):
+        messages, diagnostics = await self.run_output_daemon([
+            {"cmd": "bind_output", "epoch": "intent-epoch", "sink": "configured-sink"}])
+        self.assertTrue(any(message.get("output_binding_ready") is True
+                            and message.get("output_binding_epoch") == "intent-epoch" for message in messages), diagnostics)
+        self.assertEqual(messages[-1], {"test_moves": [17], "unrelated_sink": 0})
+
+    async def test_daemon_standby_invalidates_the_published_binding(self):
+        messages, diagnostics = await self.run_output_daemon([
+            {"cmd": "bind_output", "epoch": "intent-epoch", "sink": "configured-sink"},
+            {"cmd": "set_standby", "sink": "sendspin_fallback"}])
+        statuses = [message for message in messages if message.get("type") == "status"]
+        self.assertIs(statuses[-1].get("output_binding_ready"), False, diagnostics)
+        self.assertIsNone(statuses[-1].get("output_binding_epoch"), diagnostics)
+
+    async def test_streaming_watcher_preserves_unrelated_same_pid_output(self):
+        messages, diagnostics = await self.run_output_daemon([
+            {"cmd": "bind_output", "epoch": "intent-epoch", "sink": "configured-sink"}], streaming=True)
+        self.assertTrue(any(message.get("audio_streaming") is True for message in messages), diagnostics)
+        self.assertEqual(messages[-1], {"test_moves": [17], "unrelated_sink": 0}, diagnostics)
+
+    async def test_disabled_or_missing_token_never_opens_management(self):
+        for config in ({}, {"OUTPUT_PREPARATION_ENABLED": True, "OUTPUT_PREPARATION_TOKEN": ""}):
+            app = self.make_app(config)
+            response = app.test_client().post("/api/output/prepare", json={})
+            self.assertEqual(response.status_code, 404)
+        app = self.make_app({"OUTPUT_PREPARATION_ENABLED": True, "OUTPUT_PREPARATION_TOKEN": "machine-secret"})
+        for headers in ({}, {"Authorization": "Bearer machine-secret"},
+                        {"X-Output-Preparation-Token": "incorrect"}):
+            response = app.test_client().post("/api/output/prepare", json={}, headers=headers)
+            self.assertEqual(response.status_code, 401)
+            self.assertEqual(response.json, {"status": "error", "error": "unauthorized"})
