+"""Opt-in machine-only output preparation; independent of web/ingress login."""
+
+import asyncio
+import concurrent.futures
+import hmac
+import math
+
+from flask import Blueprint, jsonify, request
+
+from sendspin_bridge.bridge.output_preparation import OutputPreparation, PreparationError
+from sendspin_bridge.config import DEFAULT_CONFIG
+
+ERROR_STATUS = {
+    "invalid_request": 400,
+    "unknown_output": 404,
+    "cancelled": 409,
+    "superseded": 409,
+    "intent_conflict": 409,
+    "timeout": 504,
+    "output_unavailable": 503,
+    "tombstone_capacity": 503,
+}
+RELEASE_REASONS = frozenset(
+    {"stop", "pause", "idle", "ended", "cancelled", "timeout", "superseded", "disconnect", "shutdown", "error", "failed"}
+)
+
+
+def create_output_blueprint(*, config_provider, outputs_provider, loop_provider):
+    blueprint = Blueprint("output_preparation", __name__)
+    outputs = {}
+    preparation = None
+
+    @blueprint.before_request
+    def authenticate():
+        config = config_provider()
+        token = config.get("OUTPUT_PREPARATION_TOKEN", "")
+        if config.get("OUTPUT_PREPARATION_ENABLED", False) is not True or not isinstance(token, str) or not token:
+            return jsonify(status="error", error="disabled"), 404
+        supplied = request.headers.get("X-Output-Preparation-Token", "")
+        if not hmac.compare_digest(supplied.encode(), token.encode()):
+            return jsonify(status="error", error="unauthorized"), 401
+
+    async def dispatch(data, releasing, config):
+        nonlocal preparation
+        if preparation is None:
+            preparation = OutputPreparation(
+                outputs,
+                timeout_seconds=config["OUTPUT_PREPARATION_TIMEOUT_SECONDS"],
+                tombstone_ttl_seconds=config["OUTPUT_PREPARATION_TOMBSTONE_TTL_SECONDS"],
+                tombstone_limit=config["OUTPUT_PREPARATION_TOMBSTONE_LIMIT"],
+            )
+        outputs.clear()
+        outputs.update(outputs_provider())
+        if releasing:
+            return await preparation.release(data["output_id"], data["lease_id"], data["reason"])
+        return await preparation.prepare(data["output_id"], data["lease_id"], data["timeout_seconds"],
+                                         pcm_format=data.get("pcm_format"))
+
+    @blueprint.post("/api/output/prepare")
+    @blueprint.post("/api/output/release")
+    def output_request():
+        data = request.get_json(silent=True)
+        config = {**DEFAULT_CONFIG, **config_provider()}
+        releasing = request.path.endswith("/release")
+        if not isinstance(data, dict):
+            return jsonify(status="error", error="invalid_request"), 400
+        if any(not isinstance(data.get(key), str) or not 0 < len(data[key]) <= 128 for key in ("output_id", "lease_id")):
+            return jsonify(status="error", error="invalid_request"), 400
+        timeout = data.get("timeout_seconds")
+        if not releasing and (
+            type(timeout) not in (int, float)
+            or not math.isfinite(timeout)
+            or not 0 < timeout <= config["OUTPUT_PREPARATION_TIMEOUT_SECONDS"]
+        ):
+            return jsonify(status="error", error="invalid_request"), 400
+        if releasing and (not isinstance(data.get("reason"), str) or data["reason"] not in RELEASE_REASONS):
+            return jsonify(status="error", error="invalid_request"), 400
+        loop = loop_provider()
+        if loop is None or not loop.is_running():
+            return jsonify(status="error", error="output_unavailable"), 503
+        future = asyncio.run_coroutine_threadsafe(dispatch(data, releasing, config), loop)
+        try:
+            result = future.result(
+                timeout=config["OUTPUT_PREPARATION_TIMEOUT_SECONDS"] + config["OUTPUT_PREPARATION_POLL_SECONDS"]
+            )
+            return jsonify(result)
+        except PreparationError as exc:
+            return jsonify(status="error", error=exc.code), ERROR_STATUS.get(exc.code, 503)
+        except concurrent.futures.TimeoutError:
+            future.cancel()
+            return jsonify(status="error", error="timeout"), 504
+        except Exception:
+            future.cancel()
+            return jsonify(status="error", error="output_unavailable"), 503
+
+    return blueprint
