@@ -0,0 +1,216 @@
+"""Cancellable ownership of configured physical outputs, independent of music."""
+
+from __future__ import annotations
+
+import asyncio
+import math
+import secrets
+import time
+from dataclasses import asdict, dataclass
+from typing import Protocol
+
+__all__ = ["OutputBinding", "OutputFormat", "OutputPreparation", "PhysicalOutput", "PreparationError"]
+
+
+@dataclass(frozen=True)
+class OutputFormat:
+    """Decoded signed-integer PCM requested by one immutable output intent."""
+
+    sample_rate: int
+    bit_depth: int
