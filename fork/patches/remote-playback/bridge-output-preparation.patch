+"""Output-use contracts at the public Prepare/Release seam."""
+
+import asyncio
+import json
+import unittest
+from contextlib import asynccontextmanager
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from sendspin_bridge.bridge.output_preparation import OutputBinding, OutputPreparation, PreparationError
+
+
+class PhysicalOutput:
+    def __init__(self):
+        self.prepares = []
+        self.releases = []
+        self.ready = asyncio.Event()
+        self.ready.set()
+
+    async def prepare(self, epoch):
+        self.prepares.append(epoch)
+        await self.ready.wait()
+        return OutputBinding(epoch, True, True, True, True, True)
+
+    async def release(self, epoch):
+        self.releases.append(epoch)
+
+    async def validate_binding(self, epoch):
+        return True
+
+
+class PulseOutput:
+    def __init__(self):
+        self.sink = SimpleNamespace(name="configured-sink", index=6, card=2)
+        self.standby = SimpleNamespace(name="sendspin_fallback", index=0, card=None)
+        self.card = SimpleNamespace(index=2, profile_active=SimpleNamespace(name="a2dp_sink"))
+        self.owned = SimpleNamespace(index=17, sink=0, proplist={"application.process.id": "314",
+                                                              "application.name": "sendspin-owned-player"})
+        self.unrelated = SimpleNamespace(index=18, sink=0, proplist={"application.process.id": "314",
+                                                                  "application.name": "unrelated-host-player"})
+        self.streams = [self.owned, self.unrelated]
+        self.moves = []
+        self.volumes = []
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *args):
+        return False
+
+    async def sink_list(self):
+        return [self.sink, self.standby]
+
+    async def card_list(self):
+        return [self.card]
+
+    async def sink_input_list(self):
+        return self.streams
+
+    async def volume_set_all_chans(self, stream, value):
+        self.volumes.append(stream.index)
+
+    async def sink_input_move(self, stream, sink):
+        self.moves.append(stream.index)
+        stream.sink = sink.index
+
+    async def sink_mute(self, index, muted):
+        pass
+
+
+class DaemonProcess:
+    """External subprocess port: commands in, binding observations out."""
+
+    def __init__(self, pulse):
+        self.pid = 314
+        self.returncode = None
+        self.stdout = asyncio.StreamReader()
+        self.stderr = asyncio.StreamReader()
+        self.stdin = self
+        self.pulse = pulse
+        self.commands = []
+
+    def write(self, data):
+        from sendspin_bridge.services.ipc.ipc_protocol import build_status_envelope
+        command = json.loads(data)
+        self.commands.append(command)
+        if command["cmd"] == "bind_output":
+            self.pulse.owned.sink = self.pulse.sink.index
+            status = build_status_envelope({"output_binding_epoch": command["epoch"],
+                                            "output_binding_pid": self.pid,
+                                            "output_binding_sink": command["sink"],
+                                            "output_binding_ready": True})
+            self.stdout.feed_data((json.dumps(status) + "\n").encode())
+        elif command["cmd"] == "stop":
+            self.returncode = 0
+            self.stdout.feed_eof()
+            self.stderr.feed_eof()
+
+    async def drain(self):
+        pass
+
+    async def wait(self):
+        return self.returncode
+
+
+@asynccontextmanager
+async def physical_client():
+    from sendspin_bridge.bluetooth.adapter_session import LinkState
+    from sendspin_bridge.bridge.client import SendspinClient
+    from sendspin_bridge.services.audio import pulse
+
+    external = PulseOutput()
+    process = DaemonProcess(external)
+    operation = SimpleNamespace(release=lambda: None)
+    manager = SimpleNamespace(mac_address="AA:BB:CC:DD:EE:FF", check_bluetooth_available=lambda: True,
+                              adapter_handle=SimpleNamespace(try_lease=lambda reason: operation),
+                              allow_reconnect=lambda: None, cancel_reconnect=lambda: None,
+                              reconnect_cancelled=lambda: False, link_state=lambda: LinkState.CONNECTED,
+                              disconnects=[])
+    def disconnect():
+        manager.disconnects.append(True)
+        return True
+    manager.disconnect_device = disconnect
+    client = SendspinClient("configured-player", "auto", 8927, bt_manager=manager, listen_host="127.0.0.1",
+                            output_preparation_config={"OUTPUT_PREPARATION_ENABLED": True,
+                                                       "OUTPUT_PREPARATION_POLL_SECONDS": 0.001,
+                                                       "OUTPUT_PREPARATION_PAUSE_GRACE_SECONDS": 60})
+    manager.connect_prepared_output = lambda: setattr(client, "bluetooth_sink_name", "configured-sink") or True
+
+    async def spawn(*args, **kwargs):
+        external.owned.proplist["application.name"] = kwargs["env"]["PULSE_PROP_application.name"]
+        return process
+
+    with patch.object(pulse.pulsectl_asyncio, "PulseAsync", side_effect=lambda name: external), \
+            patch("asyncio.create_subprocess_exec", side_effect=spawn), \
+            patch("sendspin_bridge.bridge.client.find_available_bind_port", return_value=8928):
+        await client.start_sendspin()
+        try:
+            yield client, external, process
+        finally:
+            await client.stop_sendspin()
+
+
+def preparation_for(output, **settings):
+    config = {"timeout_seconds": 1, "tombstone_ttl_seconds": 60, "tombstone_limit": 8, **settings}
+    return OutputPreparation({"configured-player": output}, **config)
+
+
+class OutputPreparationTests(unittest.IsolatedAsyncioTestCase):
+    async def test_prepare_returns_a_verified_opaque_lease(self):
+        output = PhysicalOutput()
+        preparation = preparation_for(output)
+        result = await preparation.prepare("configured-player", "intent-1", 1)
+        self.assertEqual(result["status"], "ready")
+        self.assertEqual(result["lease_id"], "intent-1")
+        self.assertEqual(result["output_id"], "configured-player")
+        self.assertTrue(result["output_epoch"])
+        self.assertEqual(output.prepares, [result["output_epoch"]])
+
+    async def test_repeated_intent_reuses_the_verified_physical_client_binding(self):
+        async with physical_client() as (output, external, process):
+            preparation = preparation_for(output)
+            first = await preparation.prepare("configured-player", "intent", 1)
+            self.assertEqual(first["status"], "ready")
+            self.assertEqual(await preparation.prepare("configured-player", "intent", 1), first)
+            self.assertEqual([command["cmd"] for command in process.commands], ["bind_output"])
+
+    async def test_physical_release_never_moves_or_changes_unrelated_same_pid_streams(self):
+        async with physical_client() as (output, external, process):
+            await output.prepare("epoch")
+            external.unrelated.sink = external.sink.index
+            await output.release("epoch")
+            self.assertEqual(external.moves, [17])
+            self.assertEqual(external.volumes, [17])
+            self.assertEqual(external.unrelated.sink, 6)
+
+    async def test_physical_release_keeps_the_link_used_by_another_application(self):
+        async with physical_client() as (output, external, process):
+            await output.prepare("epoch")
+            external.unrelated.sink = external.sink.index
+            await output.release("epoch")
+            self.assertEqual(output.bt_manager.disconnects, [])
+            self.assertEqual(external.unrelated.sink, 6)
+            self.assertEqual(external.moves, [17])
+
+    async def test_physical_release_keeps_the_link_when_other_source_evidence_is_unknown(self):
+        for evidence in ("missing_sink", "backend_error", "unknown_source"):
+            with self.subTest(evidence=evidence):
+                async with physical_client() as (output, external, process):
+                    await output.prepare("epoch")
+                    if evidence == "missing_sink":
+                        external.sink.name = "unobserved-sink"
+                    elif evidence == "backend_error":
+                        async def unavailable():
+                            raise OSError("backend observation unavailable")
+                        external.sink_input_list = unavailable
+                    else:
+                        external.unrelated.sink = external.sink.index
+                        external.unrelated.proplist = {}
+                    await output.release("epoch")
+                    self.assertEqual(output.bt_manager.disconnects, [])
+
+    async def test_physical_release_disconnects_a_sink_observed_unused_by_other_sources(self):
+        async with physical_client() as (output, external, process):
+            await output.prepare("epoch")
+            await output.release("epoch")
+            self.assertEqual(output.bt_manager.disconnects, [True])
+            self.assertEqual(external.moves, [17])
+
+    async def test_old_release_does_not_disconnect_a_successor_during_source_observation(self):
+        async with physical_client() as (output, external, process):
+            await output.prepare("old-epoch")
+            observing = asyncio.Event()
+            continue_observation = asyncio.Event()
+            inputs = external.sink_input_list
+            observations = 0
+            async def observe():
+                nonlocal observations
+                observations += 1
+                if observations == 2:
+                    observing.set()
+                    await continue_observation.wait()
+                return await inputs()
+            external.sink_input_list = observe
+            release = asyncio.create_task(output.release("old-epoch"))
+            try:
+                await asyncio.wait_for(observing.wait(), timeout=1)
+                successor = asyncio.create_task(output.prepare("new-epoch"))
+                await asyncio.sleep(0)
+            finally:
+                continue_observation.set()
+            await release
+            binding = await successor
+            self.assertTrue(binding.ready)
+            self.assertEqual(binding.epoch, "new-epoch")
+            self.assertEqual(output.bt_manager.disconnects, [])
+
+    async def test_repeated_intent_joins_pending_work_and_reuses_ready_output(self):
+        output = PhysicalOutput()
+        output.ready.clear()
+        preparation = preparation_for(output)
+        first = asyncio.create_task(preparation.prepare("configured-player", "intent-1", 1))
+        second = asyncio.create_task(preparation.prepare("configured-player", "intent-1", 1))
+        await asyncio.sleep(0)
+        output.ready.set()
+        results = await asyncio.gather(first, second)
+        repeated = await preparation.prepare("configured-player", "intent-1", 1)
+        self.assertEqual(results[0], results[1])
+        self.assertEqual(repeated, results[0])
+        self.assertEqual(len(output.prepares), 1)
+
+    async def test_release_cancels_pending_and_prearrival_intent(self):
+        output = PhysicalOutput()
+        output.ready.clear()
+        preparation = preparation_for(output)
+        pending = asyncio.create_task(preparation.prepare("configured-player", "intent-1", 1))
+        await asyncio.sleep(0)
+        await preparation.release("configured-player", "intent-1", "stop")
+        with self.assertRaises(PreparationError) as error:
+            await pending
+        self.assertEqual(error.exception.code, "cancelled")
+        await preparation.release("configured-player", "intent-before-http", "stop")
+        output.ready.set()
+        with self.assertRaises(PreparationError) as error:
+            await preparation.prepare("configured-player", "intent-before-http", 1)
+        self.assertEqual(error.exception.code, "cancelled")
+        successor = await preparation.prepare("configured-player", "intent-2", 1)
+        releases = list(output.releases)
+        await preparation.release("configured-player", "intent-1", "stop")
+        self.assertEqual(output.releases, releases)
+        self.assertEqual(await preparation.prepare("configured-player", "intent-2", 1), successor)
+
+    async def test_new_intent_supersedes_late_ready_and_old_cleanup(self):
+        output = PhysicalOutput()
+        started = asyncio.Event()
+        finish_old = asyncio.Event()
+        async def prepare(epoch):
+            output.prepares.append(epoch)
+            if len(output.prepares) == 1:
+                started.set()
+                try:
+                    await finish_old.wait()
+                except asyncio.CancelledError:
+                    await finish_old.wait()
+            return OutputBinding(epoch, True, True, True, True, True)
+        output.prepare = prepare
+        preparation = preparation_for(output)
+        old = asyncio.create_task(preparation.prepare("configured-player", "old", 1))
+        await started.wait()
+        successor = await preparation.prepare("configured-player", "new", 1)
+        finish_old.set()
+        with self.assertRaises(PreparationError) as error:
+            await old
+        self.assertEqual(error.exception.code, "superseded")
+        await preparation.release("configured-player", "old", "stop")
+        self.assertEqual(output.releases, [])
+        self.assertEqual(await preparation.prepare("configured-player", "new", 1), successor)
+
+    async def test_deadline_rejects_output_and_cancels_known_intent(self):
+        output = PhysicalOutput()
+        output.ready.clear()
+        preparation = preparation_for(output, timeout_seconds=0.01)
+        with self.assertRaises(PreparationError) as error:
+            await asyncio.wait_for(preparation.prepare("configured-player", "deadline", 1), 0.2)
+        self.assertEqual(error.exception.code, "timeout")
+        output.ready.set()
+        with self.assertRaises(PreparationError):
+            await preparation.prepare("configured-player", "deadline", 1)
+
+    async def test_cancel_records_are_bounded_without_reviving_recent_intents(self):
+        now = [0.0]
+        output = PhysicalOutput()
+        preparation = preparation_for(output, tombstone_limit=1, clock=lambda: now[0])
