+    def __init__(self, outputs, *, timeout_seconds, tombstone_ttl_seconds, tombstone_limit, clock=time.monotonic):
+        self._outputs = outputs
+        self._timeout_seconds = timeout_seconds
+        self._tombstone_ttl = tombstone_ttl_seconds
+        self._tombstone_limit = tombstone_limit
+        self._clock = clock
+        self._leases: dict[str, _Lease] = {}
+        self._tombstones: dict[tuple[str, str], float] = {}
+        self._tasks: set[asyncio.Task] = set()
+
+    def _track(self, coroutine):
+        task = asyncio.create_task(coroutine)
+        self._tasks.add(task)
+
+        def finished(task):
+            self._tasks.discard(task)
+            if not task.cancelled():
+                task.exception()
+        task.add_done_callback(finished)
+        return task
+
+    def _prune(self):
+        now = self._clock()
+        self._tombstones = {key: expires for key, expires in self._tombstones.items() if expires > now}
+
+    def _remember(self, output_id, lease_id):
+        self._prune()
+        key = (output_id, lease_id)
+        if key not in self._tombstones and len(self._tombstones) >= self._tombstone_limit:
+            raise PreparationError("tombstone_capacity")
+        self._tombstones[key] = self._clock() + self._tombstone_ttl
+
+    def _revoke(self, lease, code):
+        lease.revoked = code
+        if not lease.result.done():
+            lease.result.set_exception(PreparationError(code))
+        if lease.task is not None:
+            lease.task.cancel()
