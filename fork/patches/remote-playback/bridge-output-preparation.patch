+from types import SimpleNamespace
+from unittest.mock import patch
+
+from sendspin_bridge.bridge.output_preparation import OutputBinding, OutputPreparation, PreparationError
+
+
+class PhysicalOutput:
+    def __init__(self):
+        self.prepares = []
+        self.formats = []
+        self.releases = []
+        self.ready = asyncio.Event()
+        self.ready.set()
+
+    async def prepare(self, epoch, pcm_format=None):
+        self.prepares.append(epoch)
+        self.formats.append(pcm_format)
+        await self.ready.wait()
+        return OutputBinding(epoch, True, True, True, True, True)
+
+    async def release(self, epoch):
+        self.releases.append(epoch)
+
+    async def validate_binding(self, epoch):
+        return True
+
+
+class PulseOutput:
+    def __init__(self):
+        self.sink = SimpleNamespace(name="configured-sink", index=6, card=2)
+        self.standby = SimpleNamespace(name="sendspin_fallback", index=0, card=None)
+        self.card = SimpleNamespace(index=2, profile_active=SimpleNamespace(name="a2dp_sink"))
+        self.owned = SimpleNamespace(index=17, sink=0, proplist={"application.process.id": "314",
+                                                              "application.name": "sendspin-owned-player"})
+        self.unrelated = SimpleNamespace(index=18, sink=0, proplist={"application.process.id": "314",
+                                                                  "application.name": "unrelated-host-player"})
+        self.streams = [self.owned, self.unrelated]
+        self.moves = []
+        self.volumes = []
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *args):
+        return False
+
+    async def sink_list(self):
+        return [self.sink, self.standby]
+
+    async def card_list(self):
+        return [self.card]
+
+    async def sink_input_list(self):
+        return self.streams
+
+    async def volume_set_all_chans(self, stream, value):
+        self.volumes.append(stream.index)
+
+    async def sink_input_move(self, stream, sink):
+        self.moves.append(stream.index)
+        stream.sink = sink.index
+
+    async def sink_mute(self, index, muted):
+        pass
+
+
+class DaemonProcess:
+    """External subprocess port: commands in, binding observations out."""
+
+    def __init__(self, pulse):
+        self.pid = 314
+        self.returncode = None
+        self.stdout = asyncio.StreamReader()
+        self.stderr = asyncio.StreamReader()
+        self.stdin = self
+        self.pulse = pulse
+        self.commands = []
+        self.hold_binding_acks = False
+        self.binding_requested = asyncio.Event()
+
+    def write(self, data):
+        from sendspin_bridge.services.ipc.ipc_protocol import build_status_envelope
+        command = json.loads(data)
+        self.commands.append(command)
+        if command["cmd"] == "bind_output":
+            self.binding_requested.set()
+            self.pulse.owned.sink = self.pulse.sink.index
+            if self.hold_binding_acks:
+                return
+            status = build_status_envelope({"output_binding_request_id": command.get("request_id"),
+                                            "output_binding_epoch": command["epoch"],
+                                            "output_binding_pid": self.pid,
+                                            "output_binding_sink": command["sink"],
+                                            "output_binding_ready": True})
+            self.stdout.feed_data((json.dumps(status) + "\n").encode())
+        elif command["cmd"] == "stop":
+            self.returncode = 0
+            self.stdout.feed_eof()
+            self.stderr.feed_eof()
+
+    async def drain(self):
+        pass
+
+    async def wait(self):
+        return self.returncode
+
+
+@asynccontextmanager
+async def physical_client(*, native_identity=False):
+    from sendspin_bridge.bluetooth.adapter_session import LinkState
+    from sendspin_bridge.bridge.client import SendspinClient
+    from sendspin_bridge.services.audio import pulse
+
+    external = PulseOutput()
+    process = DaemonProcess(external)
+    operation = SimpleNamespace(release=lambda: None)
+    manager = SimpleNamespace(mac_address="AA:BB:CC:DD:EE:FF", check_bluetooth_available=lambda: True,
+                              adapter_handle=SimpleNamespace(try_lease=lambda reason: operation),
+                              allow_reconnect=lambda: None, cancel_reconnect=lambda: None,
+                              reconnect_cancelled=lambda: False, link_state=lambda: LinkState.CONNECTED,
+                              disconnects=[])
+    def disconnect():
+        manager.disconnects.append(True)
+        return True
+    manager.disconnect_device = disconnect
+    client = SendspinClient("configured-player", "auto", 8927, bt_manager=manager, listen_host="127.0.0.1",
+                            output_preparation_config={"OUTPUT_PREPARATION_ENABLED": True,
+                                                       "OUTPUT_PREPARATION_POLL_SECONDS": 0.001,
+                                                       "OUTPUT_PREPARATION_PAUSE_GRACE_SECONDS": 60})
+    manager.connect_prepared_output = lambda: setattr(client, "bluetooth_sink_name", "configured-sink") or True
+
+    async def spawn(*args, **kwargs):
+        # Native ALSA Pulse explicitly names its context; the fallback property
+        # does not win. This behavior was observed in the pinned runtime image.
+        if native_identity:
+            name = kwargs["env"].get("PULSE_PROP_OVERRIDE_application.name", "ALSA plug-in [python3.13]")
+        else:
+            name = kwargs["env"]["PULSE_PROP_application.name"]
+        external.owned.proplist["application.name"] = name
+        return process
+
+    with patch.object(pulse.pulsectl_asyncio, "PulseAsync", side_effect=lambda name: external), \
+            patch("asyncio.create_subprocess_exec", side_effect=spawn), \
+            patch("sendspin_bridge.bridge.client.find_available_bind_port", return_value=8928):
+        await client.start_sendspin()
+        try:
+            yield client, external, process
+        finally:
+            await client.stop_sendspin()
+
+
+class SdkTransport:
+    """External transport listeners and deterministic clock, not a playback implementation."""
+
+    def __init__(self):
+        self.connected = False
+        self.callbacks = {name: [] for name in ("chunk", "start", "end", "clear")}
+        self.chunks_sent = 0
+        self.timestamp = 1_000_000
+
+    def _listen(self, name, callback):
+        self.callbacks[name].append(callback)
+        return lambda: self.callbacks[name].remove(callback)
+
+    def add_audio_chunk_listener(self, callback):
+        return self._listen("chunk", callback)
+
+    def add_stream_start_listener(self, callback):
+        return self._listen("start", callback)
+
+    def add_stream_end_listener(self, callback):
+        return self._listen("end", callback)
+
+    def add_stream_clear_listener(self, callback):
+        return self._listen("clear", callback)
+
+    def compute_play_time(self, timestamp):
+        return timestamp
+
+    def compute_server_time(self, timestamp):
+        return timestamp
+
+    def now_us(self):
+        return self.timestamp
+
+    def is_time_synchronized(self):
+        return True
