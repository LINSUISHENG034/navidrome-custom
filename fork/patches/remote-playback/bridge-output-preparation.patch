+class SdkBackendPort:
+    """PortAudio boundary with observable allocations, closes, and actual SDK samples."""
+
+    def __init__(self):
+        self.streams = []
+        self.started = threading.Event()
+        self.closed = threading.Event()
+        self.before_open = lambda: None
+        self.on_open = lambda stream: None
+        self.on_close = lambda stream: None
+        self.before_close = lambda stream: None
+        self.before_stop = lambda stream: None
+        self.close_attempts = []
+        self.stop_attempts = []
+
+    def fail_close_once(self, message):
+        entered = threading.Event()
+        previous = len(self.close_attempts)
+
+        def fail(stream):
+            entered.set()
+            if len(self.close_attempts) == previous + 1:
+                raise OSError(message)
+
+        self.before_close = fail
+        return entered
+
+    def gate_close(self, timeout, *, fail_first=False):
+        entered, finish = threading.Event(), threading.Event()
+        previous = len(self.close_attempts)
+
+        def wait(stream):
+            if fail_first and len(self.close_attempts) == previous + 1:
+                raise OSError("External first close failed")
+            entered.set()
+            if not finish.wait(timeout):
+                raise RuntimeError("External close was not released")
+
+        self.before_close = wait
+        return entered, finish
+
+    def open(self, **kwargs):
+        self.before_open()
+        port = self
+
+        class Stream:
+            latency = 0.1
+
+            def __init__(self):
+                self.closed = False
+                self.samples = []
+                self.settings = kwargs
+
+            def start(self):
+                width = int(kwargs["dtype"].removeprefix("int")) // 8
+                output = bytearray(16 * kwargs["channels"] * width)
+                kwargs["callback"](memoryview(output), 16,
+                                   SimpleNamespace(currentTime=0.9, outputBufferDacTime=1.0), False)
+                self.samples.append(bytes(output))
+                port.started.set()
+
+            def stop(self):
+                port.stop_attempts.append(self)
+                port.before_stop(self)
+
+            def close(self):
+                port.close_attempts.append(self)
+                port.before_close(self)
+                self.closed = True
+                port.on_close(self)
+                port.closed.set()
+
+        stream = Stream()
+        self.streams.append(stream)
+        self.on_open(stream)
+        return stream
+
