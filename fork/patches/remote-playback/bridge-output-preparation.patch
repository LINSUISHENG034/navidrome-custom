+    async def test_crashed_worker_recovery_preserves_gate_for_stream_start_and_reattach(self):
+        for recovery in ("stream_start", "reattach"):
+            with self.subTest(recovery=recovery):
+                self.backend.closed.clear()
+                self.backend.started.clear()
+                await self.handler.prepare_output(self.format, "before-crash")
+                allocations = len(self.backend.streams)
+                self.transport.timestamp = None  # External clock failure in the real submit path.
+                self.transport.emit_audio(bytes(range(64)) * 800, self.format, timestamp=1_000_000)
+                self.assertTrue(await asyncio.to_thread(self.backend.closed.wait, 1))
+                self.assertTrue(self.backend.streams[-1].closed)
+                with self.assertRaises(RuntimeError):
+                    await self.handler.release_output("before-crash")
+                self.transport.timestamp = 1_000_000
+                async with asyncio.timeout(1):
+                    while True:
+                        if recovery == "reattach":
+                            self.handler.attach_client(self.transport)
+                        else:
+                            self.transport.emit_start(self.format)
+                        try:
+                            await self._release_barrier()
+                            break
+                        except RuntimeError as exc:
+                            if str(exc) != "Audio worker is not running":
+                                raise
+                            await asyncio.sleep(0.001)
+                self.transport.emit_audio(bytes(range(64)) * 800, self.format)
+                await self._release_barrier()
+                self.assertEqual(len(self.backend.streams), allocations)
+                self.assertFalse(self.backend.started.is_set())
+                await self.handler.prepare_output(self.format, "after-crash")
+                await self.handler.release_output("before-crash")
+                self.assertFalse(self.backend.streams[-1].closed)
+                self.transport.emit_audio(bytes(range(64)) * 800, self.format)
+                self.assertTrue(await asyncio.to_thread(self.backend.started.wait, 1))
+                self.assertEqual(len(self.backend.streams), allocations + 1)
+                self.assertEqual(self.backend.streams[-1].samples, [bytes(range(64))])
+                await self.handler.handle_disconnect()
+                self.handler.attach_client(self.transport)
