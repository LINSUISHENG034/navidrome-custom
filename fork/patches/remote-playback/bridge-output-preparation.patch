+    async def prepare(self, output_id: str, lease_id: str, timeout_seconds: float) -> dict:
+        if type(timeout_seconds) not in (int, float) or not math.isfinite(timeout_seconds) or timeout_seconds <= 0:
+            raise PreparationError("invalid_request")
+        if output_id not in self._outputs:
+            raise PreparationError("unknown_output")
+        self._prune()
+        if (output_id, lease_id) in self._tombstones:
+            raise PreparationError("cancelled")
+        lease = self._leases.get(output_id)
+        if lease is None or lease.lease_id != lease_id:
+            if len(self._tombstones) + len(self._leases) >= self._tombstone_limit:
+                raise PreparationError("tombstone_capacity")
+            if lease is not None:
+                self._remember(output_id, lease.lease_id)
+                self._revoke(lease, "superseded")
+            result = asyncio.get_running_loop().create_future()
+            result.add_done_callback(lambda done: None if done.cancelled() else done.exception())
