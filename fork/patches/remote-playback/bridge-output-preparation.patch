+    async def _cleanup(self, output_id, lease):
+        if output_id not in self._leases:
+            await lease.output.release(lease.epoch)
+
+    async def release(self, output_id: str, lease_id: str, reason: str) -> dict:
+        if output_id not in self._outputs and output_id not in self._leases:
+            raise PreparationError("unknown_output")
+        self._prune()
+        lease = self._leases.get(output_id)
+        current = lease is not None and lease.lease_id == lease_id
+        if not current and (output_id, lease_id) not in self._tombstones:
+            if len(self._tombstones) + len(self._leases) >= self._tombstone_limit:
+                raise PreparationError("tombstone_capacity")
+        self._remember(output_id, lease_id)
+        if current:
+            self._leases.pop(output_id)
+            code = reason if reason in ("timeout", "output_unavailable") else "cancelled"
+            self._revoke(lease, code)
+            self._track(self._cleanup(output_id, lease))
+        return {"status": "released", "output_id": output_id, "lease_id": lease_id}
