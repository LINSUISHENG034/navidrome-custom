+class MediaPorts:
+    """Observable music source, output and clock ports for a real session."""
+
+    def __init__(self) -> None:
+        self.events: list[str] = []
+        self.read_started = asyncio.Event()
+        self.committed = asyncio.Event()
+        self.eof = asyncio.Event()
+        self.drain_started = asyncio.Event()
+        self.drain_gate: asyncio.Event | None = None
+        self.stream_count = 0
+        self.start_error: Exception | None = None
+
+    def get_stream(self, *args: Any) -> Any:
+        self.events.append("read")
+        self.read_started.set()
+
+        async def source() -> Any:
+            yield b"\x00" * 3840
+            await self.eof.wait()
+
+        return source()
+
+    def start_stream(self, **kwargs: Any) -> Any:
+        if self.start_error is not None:
+            raise self.start_error
+        self.events.append("stream")
+        self.stream_count += 1
+        ports = self
+
+        class PushOutput:
+            is_stopped = False
+
+            def set_live_source(self, live: bool) -> None:
+                return None
+
+            def prepare_audio(self, *args: Any, **kwargs: Any) -> None:
+                return None
+
+            async def commit_audio(self) -> int:
+                ports.events.append("commit")
+                ports.committed.set()
+                return 1_000_000
+
+            async def sleep_to_limit_buffer(self, limit: int) -> None:
+                if limit == 0:
+                    ports.drain_started.set()
+                    if ports.drain_gate is not None:
+                        await ports.drain_gate.wait()
+
+            def now_us(self) -> int:
+                return 1_000_000
+
+            def clear(self) -> None:
+                ports.events.append("clear")
+
+            def stop(self, *, keep_stream: bool = False) -> None:
+                self.is_stopped = True
+                ports.events.append("stream-stop")
+
+        return PushOutput()
+
+    async def stop(self) -> None:
+        self.events.append("group-stop")
+
+
+class NegotiatedPlayerRole(PlayerV1Role):
+    """External Sendspin negotiation port, independent of MA's internal F32 pipeline."""
+
+    def __init__(self) -> None:
+        super().__init__(SimpleNamespace())
+        self.audio_format: SendspinAudioFormat | None = SendspinAudioFormat(
+            sample_rate=48000, bit_depth=16, channels=2, sample_type="int"
+        )
+        self.codec: AudioCodec | None = AudioCodec.PCM
+
+    @property
+    def preferred_format(self) -> SendspinAudioFormat | None:
+        return self.audio_format
+
+    @property
+    def preferred_codec(self) -> AudioCodec | None:
+        return self.codec
+
+
+class SessionPlayer:
+    """Player input with external HTTP and media ports, without a second queue."""
+
+    def __init__(self, http: HttpPort, ports: MediaPorts, *, enabled: bool = True) -> None:
+        self.player_id = "test-player"
+        self.logger = logging.getLogger("output-preparation-test")
+        self.values: dict[str, Any] = {
+            "output_preparation_url": "https://output-manager.example" if enabled else "",
+            "output_preparation_output_id": "configured-output",
+            "output_preparation_token": "machine-secret",
+            "output_preparation_timeout": 0.1,
+        }
+        self.config = SimpleNamespace(get_value=lambda key, default=None: self.values.get(key, default))
+        self.api = SimpleNamespace(
+            group=SimpleNamespace(
+                start_stream=ports.start_stream,
+                stop=ports.stop,
+                clients=[SimpleNamespace(client_id=self.player_id)],
+            )
+        )
+        self.negotiated_role = NegotiatedPlayerRole()
+        self.provider = SimpleNamespace(
+            server_api=SimpleNamespace(
+                get_client=lambda player_id: SimpleNamespace(
+                    roles_by_family=lambda family: [self.negotiated_role]
+                ),
+                allow_noncompliant_clients=False,
+            )
+        )
+        self.mass = SimpleNamespace(
+            http_session=http,
+            config=SimpleNamespace(
+                get_player_dsp_config=lambda player_id: SimpleNamespace(enabled=False),
+                get_raw_player_config_value=lambda player_id, key, default: default,
+            ),
+            streams=SimpleNamespace(
+                get_stream=ports.get_stream,
+                audio=SimpleNamespace(
+                    get_player_output_plan=lambda *args, **kwargs: SimpleNamespace(filter_params=[])
+                ),
+            ),
+        )
+        self.volume_level = 42
+        self.volume_muted = False
+        self._metadata_role = None
+        self._extra_attributes: dict[str, Any] = {}
+        self.ports = ports
+
+    async def volume_set(self, volume: int) -> None:
+        self.ports.events.append(f"volume:{volume}")
+
+    async def volume_mute(self, muted: bool) -> None:
+        self.ports.events.append(f"mute:{muted}")
+
+    def update_state(self) -> None:
+        return None
