+"""Correlated output preparation before Sendspin content streaming."""
+
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass
+from ipaddress import ip_address
+from math import isfinite
+from typing import TYPE_CHECKING, Any
+from urllib.parse import urlsplit
+from uuid import uuid4
+
+from aiohttp import ClientError, ClientTimeout
+
+from .constants import MAX_OUTPUT_PREPARATION_TIMEOUT
+
+if TYPE_CHECKING:
+    from aiohttp import ClientSession
+
+
+class OutputPreparationError(RuntimeError):
+    """The configured output did not grant usable output authority."""
+
+
+@dataclass(frozen=True, slots=True)
+class OutputLease:
+    """Output usage owned by one caller-generated lease nonce."""
+
+    output_id: str
+    lease_id: str
+    output_epoch: str
+    pcm_format: tuple[int, int, int] | None = None
+
+
+class OutputPreparationClient:
+    """Prepare a configured output through its authenticated management interface."""
+
+    def __init__(
+        self,
+        http_session: ClientSession,
+        url: str,
+        output_id: str,
+        token: str,
+        timeout_seconds: float,
+    ) -> None:
+        """Bind the client to one configured physical output."""
+        if (
+            not isinstance(output_id, str)
+            or not output_id.strip()
+            or not isinstance(token, str)
+            or not token.strip()
+            or any(ord(char) <= 32 or ord(char) == 127 for char in token)
+        ):
+            raise OutputPreparationError("Output preparation requires an output ID and machine token")
+        if (
+            isinstance(timeout_seconds, bool)
+            or not isinstance(timeout_seconds, (int, float))
+            or not isfinite(timeout_seconds)
+            or not 0 < timeout_seconds <= MAX_OUTPUT_PREPARATION_TIMEOUT
+        ):
+            raise OutputPreparationError("Output preparation requires a bounded positive deadline")
+        self._http_session = http_session
+        self._url = self._validate_url(url).rstrip("/")
+        self._output_id = output_id
+        self._token = token
+        self._timeout_seconds = timeout_seconds
+        self._release_tasks: set[asyncio.Task[None]] = set()
+
+    async def prepare(
+        self, lease: OutputLease | None = None, *, pcm_format: dict[str, int] | None = None
+    ) -> OutputLease:
+        """
+        Obtain or revalidate a correlated output lease before consuming content.
+
+        :param lease: Existing lease handed to this preparation; any failure revokes it.
+        :param pcm_format: Negotiated integer dimensions; omission preserves the lease format.
+        """
+        try:
+            normalized_format = (
+                self._normalize_pcm_format(pcm_format)
+                if pcm_format is not None
+                else lease.pcm_format if lease is not None else None
+            )
+            if lease is not None and normalized_format != lease.pcm_format:
+                raise OutputPreparationError("Output lease PCM format cannot change")
+            if lease is None:
+                lease = OutputLease(self._output_id, uuid4().hex, "", normalized_format)
+            request: dict[str, Any] = {
+                "output_id": lease.output_id,
+                "lease_id": lease.lease_id,
+                "timeout_seconds": self._timeout_seconds,
+            }
+            if normalized_format is not None:
+                request["pcm_format"] = dict(
+                    zip(("sample_rate", "bit_depth", "channels"), normalized_format, strict=True)
+                )
+            payload = await self._request("prepare", request)
+            if (
+                not isinstance(payload, dict)
+                or payload.get("status") != "ready"
+                or payload.get("output_id") != lease.output_id
+                or payload.get("lease_id") != lease.lease_id
+                or not isinstance(payload.get("output_epoch"), str)
+                or not payload["output_epoch"]
+            ):
+                raise OutputPreparationError("Output preparation returned an invalid readiness lease")
+            if (
+                normalized_format is not None
+                and self._normalize_pcm_format(payload.get("pcm_format")) != normalized_format
+            ):
+                raise OutputPreparationError("Output preparation returned a mismatched PCM format")
+            task = asyncio.current_task()
+            if task is not None and task.cancelling():
+                raise asyncio.CancelledError
+            return OutputLease(
+                lease.output_id, lease.lease_id, payload["output_epoch"], normalized_format
+            )
+        except asyncio.CancelledError:
+            self._schedule_release(lease, "cancelled")
+            raise
+        except TimeoutError:
+            self._schedule_release(lease, "timeout")
+            raise OutputPreparationError("Output preparation timed out") from None
+        except OutputPreparationError:
+            self._schedule_release(lease, "failed")
+            raise
+
+    async def release(self, lease: OutputLease, reason: str) -> None:
+        """Revoke this caller's pending or ready output lease."""
+        await self._request(
+            "release", {"output_id": lease.output_id, "lease_id": lease.lease_id, "reason": reason}
+        )
+
+    @staticmethod
+    def _normalize_pcm_format(pcm_format: Any) -> tuple[int, int, int]:
+        keys = ("sample_rate", "bit_depth", "channels")
+        if (
+            not isinstance(pcm_format, dict)
+            or set(pcm_format) != set(keys)
+            or any(type(pcm_format[key]) is not int for key in keys)
+            or pcm_format["sample_rate"] <= 0
+            or pcm_format["bit_depth"] not in (16, 24, 32)
+            or pcm_format["channels"] <= 0
+        ):
+            raise OutputPreparationError("Output preparation requires an integer PCM format")
+        return pcm_format["sample_rate"], pcm_format["bit_depth"], pcm_format["channels"]
+
+    @staticmethod
+    def _validate_url(url: str) -> str:
+        if not isinstance(url, str) or any(ord(char) <= 32 or ord(char) == 127 for char in url):
+            raise OutputPreparationError("Invalid output preparation URL")
+        try:
+            parts = urlsplit(url)
+            hostname = parts.hostname
+            port = parts.port
+        except ValueError:
+            raise OutputPreparationError("Invalid output preparation URL") from None
+        if (
+            not hostname
+            or parts.username is not None
+            or parts.password is not None
+            or "?" in url
+            or "#" in url
+            or port == 0
+        ):
+            raise OutputPreparationError("Invalid output preparation URL")
+        loopback = hostname.lower() == "localhost"
+        if not loopback:
+            try:
+                loopback = ip_address(hostname).is_loopback
+            except ValueError:
+                loopback = False
+        if parts.scheme != "https" and not (parts.scheme == "http" and loopback):
+            raise OutputPreparationError("Output preparation requires HTTPS outside loopback")
+        return url
+
+    async def _request(self, action: str, payload: dict[str, Any]) -> Any:
+        try:
+            async with asyncio.timeout(self._timeout_seconds):
+                async with self._http_session.post(
+                    f"{self._url}/api/output/{action}",
+                    json=payload,
+                    headers={"X-Output-Preparation-Token": self._token},
+                    allow_redirects=False,
+                    timeout=ClientTimeout(total=self._timeout_seconds),
+                ) as response:
+                    if not 200 <= response.status < 300:
+                        raise OutputPreparationError("Output management request was rejected")
+                    if action == "prepare":
+                        return await response.json()
+                    return None
+        except (ClientError, ValueError):
+            raise OutputPreparationError("Output management request failed") from None
+
+    def _schedule_release(self, lease: OutputLease | None, reason: str) -> None:
+        if lease is None:
+            return
+        task = asyncio.create_task(self.release(lease, reason))
+        self._release_tasks.add(task)
+
+        def done(completed: asyncio.Task[None]) -> None:
+            self._release_tasks.discard(completed)
+            if not completed.cancelled():
+                completed.exception()
+
+        task.add_done_callback(done)
