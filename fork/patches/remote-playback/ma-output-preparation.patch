new file mode 100644
index 0000000000000000000000000000000000000000..9c792b28d8ce2a4c05b371ceea33f71abe379410
--- /dev/null
+++ b/tests/test_output_preparation_client.py
@@ -0,0 +1,856 @@
+"""Output preparation contract at the public HTTP client seam."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import unittest
+from types import SimpleNamespace
+from typing import Any
+
+from aiosendspin.models.types import AudioCodec
+from aiosendspin.server.audio import AudioFormat as SendspinAudioFormat
+from aiosendspin.server.roles.player.v1 import PlayerV1Role
+
+
+class HttpResponse:
+    """External HTTP response with a request-correlated ready payload."""
+
+    def __init__(
+        self,
+        payload: dict[str, Any],
+        gate: asyncio.Event | None = None,
+        status: int = 200,
+        cancel_on_ready: bool = False,
+        error: Exception | None = None,
+    ) -> None:
+        self.error = error
+        self.payload = payload
+        self.gate = gate
+        self.status = status
+        self.cancel_on_ready = cancel_on_ready
+
+    async def __aenter__(self) -> HttpResponse:
+        if self.gate is not None:
+            await self.gate.wait()
+        return self
+
+    async def __aexit__(self, *args: Any) -> None:
+        return None
+
+    async def json(self) -> dict[str, Any]:
+        if self.error is not None:
+            raise self.error
+        if self.cancel_on_ready:
+            task = asyncio.current_task()
+            assert task is not None
+            task.cancel()
+        return self.payload
+
+
+class HttpPort:
+    """Record requests made to the external output manager."""
+
+    def __init__(
+        self,
+        payload_updates: dict[str, Any] | None = None,
+        *,
+        gate: asyncio.Event | None = None,
+        status: int = 200,
+        cancel_on_ready: bool = False,
+        prepare_error: Exception | None = None,
+    ) -> None:
+        self.prepare_error = prepare_error
+        self.requests: list[tuple[str, dict[str, Any]]] = []
+        self.payload_updates = payload_updates or {}
+        self.gate = gate
+        self.status = status
+        self.cancel_on_ready = cancel_on_ready
+        self.prepare_started = asyncio.Event()
+
+    def post(self, url: str, **kwargs: Any) -> HttpResponse:
+        self.requests.append((url, kwargs))
+        body = kwargs["json"]
+        is_prepare = url.endswith("/prepare")
+        if is_prepare:
+            self.prepare_started.set()
+        return HttpResponse(
+            {
+                "status": "ready",
+                "output_id": body["output_id"],
+                "lease_id": body["lease_id"],
+                "output_epoch": "opaque-backend-generation",
+                **({"pcm_format": body["pcm_format"]} if "pcm_format" in body else {}),
+                **self.payload_updates,
+            },
+            self.gate if is_prepare else None,
+            self.status if is_prepare else 200,
+            self.cancel_on_ready if is_prepare else False,
+            self.prepare_error if is_prepare else None,
+        )
+
+
+class OutputPreparationClientTests(unittest.IsolatedAsyncioTestCase):
+    """Caller-owned nonces are correlated with output readiness."""
+
+    async def test_prepare_returns_only_the_requested_output_and_lease(self) -> None:
+        from music_assistant.providers.sendspin.output_preparation import OutputPreparationClient
+
+        http = HttpPort()
+        client = OutputPreparationClient(
+            http, "https://output-manager.example", "configured-output", "machine-secret", 0.1
+        )
+
+        lease = await client.prepare()
+
+        url, request = http.requests[0]
+        self.assertEqual(url, "https://output-manager.example/api/output/prepare")
+        self.assertEqual(request["json"]["output_id"], "configured-output")
+        self.assertEqual(request["json"]["lease_id"], lease.lease_id)
+        self.assertTrue(lease.lease_id)
+        self.assertEqual(request["json"]["timeout_seconds"], 0.1)
+        self.assertEqual(request["headers"], {"X-Output-Preparation-Token": "machine-secret"})
+        self.assertFalse(request["allow_redirects"])
+        self.assertEqual(lease.output_id, "configured-output")
+        self.assertEqual(lease.output_epoch, "opaque-backend-generation")
+
+    async def test_prepare_carries_pcm_format_and_revalidates_the_same_lease(self) -> None:
+        from music_assistant.providers.sendspin.output_preparation import OutputPreparationClient
+
+        http = HttpPort()
+        client = OutputPreparationClient(
+            http, "https://output-manager.example", "configured-output", "machine-secret", 0.1
+        )
+        lease = await client.prepare(
+            pcm_format={"sample_rate": 48000, "bit_depth": 24, "channels": 2}
+        )
+        await client.prepare(lease)
+
+        for _, request in http.requests:
+            self.assertEqual(
+                request["json"]["pcm_format"],
+                {"sample_rate": 48000, "bit_depth": 24, "channels": 2},
+            )
+            self.assertEqual(request["json"]["lease_id"], lease.lease_id)
+
+    async def test_invalid_pcm_dimensions_fail_before_allocating_http_lease(self) -> None:
+        from music_assistant.providers.sendspin.output_preparation import OutputPreparationClient
+
+        for pcm_format in (
+            {"sample_rate": 0, "bit_depth": 16, "channels": 2},
+            {"sample_rate": 48000, "bit_depth": 8, "channels": 2},
+            {"sample_rate": 48000, "bit_depth": 16, "channels": 0},
+            {"sample_rate": 48000.0, "bit_depth": 16, "channels": 2},
+            {"sample_rate": 48000, "bit_depth": 16, "channels": True},
+            {"sample_rate": 48000, "bit_depth": 32, "channels": 2, "sample_type": "float"},
+        ):
+            with self.subTest(pcm_format=pcm_format):
+                http = HttpPort()
+                client = OutputPreparationClient(
+                    http, "https://output-manager.example", "configured-output", "machine-secret", 0.1
+                )
+                with self.assertRaises(RuntimeError):
+                    await client.prepare(pcm_format=pcm_format)
+                self.assertEqual(http.requests, [])
+
+    async def test_lease_pcm_format_cannot_change_before_revalidation_http(self) -> None:
+        """Failed revalidation releases its handed-off lease without another Prepare."""
+        from music_assistant.providers.sendspin.output_preparation import OutputPreparationClient
+
+        for changed_dimensions in (
+            {"bit_depth": 16}, {"sample_rate": 44100}, {"channels": 1}
+        ):
+            with self.subTest(changed_dimensions=changed_dimensions):
+                http = HttpPort()
+                client = OutputPreparationClient(
+                    http, "https://output-manager.example", "configured-output", "machine-secret", 0.1
