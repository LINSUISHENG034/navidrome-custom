+class NegotiatedPlayerRole(PlayerV1Role):
+    """External Sendspin negotiation port, independent of MA's internal F32 pipeline."""
+
+    def __init__(self) -> None:
+        super().__init__(SimpleNamespace())
+        self.audio_format: SendspinAudioFormat | None = SendspinAudioFormat(
+            sample_rate=48000, bit_depth=16, channels=2, sample_type="int"
+        )
+        self.codec: AudioCodec | None = AudioCodec.PCM
+
+    @property
+    def preferred_format(self) -> SendspinAudioFormat | None:
+        return self.audio_format
+
+    @property
+    def preferred_codec(self) -> AudioCodec | None:
+        return self.codec
