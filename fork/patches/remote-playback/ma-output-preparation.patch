+class MediaPorts:
+    """Observable music source, output and clock ports for a real session."""
+
+    def __init__(self) -> None:
+        self.events: list[str] = []
+        self.read_started = asyncio.Event()
+        self.committed = asyncio.Event()
+        self.stream_stopped = asyncio.Event()
+        self.eof = asyncio.Event()
+        self.drain_started = asyncio.Event()
+        self.drain_gate: asyncio.Event | None = None
+        self.stream_count = 0
+        self.start_error: Exception | None = None
+
+    def get_stream(self, *args: Any) -> Any:
+        self.events.append("read")
+        self.read_started.set()
+
+        async def source() -> Any:
+            yield b"\x00" * 3840
+            await self.eof.wait()
+
+        return source()
+
+    def start_stream(self, **kwargs: Any) -> Any:
+        if self.start_error is not None:
+            raise self.start_error
+        self.events.append("stream")
+        self.stream_count += 1
+        ports = self
+
+        class PushOutput:
+            is_stopped = False
+
+            def set_live_source(self, live: bool) -> None:
+                return None
+
+            def prepare_audio(self, *args: Any, **kwargs: Any) -> None:
+                return None
+
+            async def commit_audio(self) -> int:
+                ports.events.append("commit")
+                ports.committed.set()
+                return 1_000_000
+
+            async def sleep_to_limit_buffer(self, limit: int) -> None:
+                if limit == 0:
+                    ports.drain_started.set()
+                    if ports.drain_gate is not None:
+                        await ports.drain_gate.wait()
+
+            def now_us(self) -> int:
+                return 1_000_000
+
+            def clear(self) -> None:
+                ports.events.append("clear")
+
+            def stop(self, *, keep_stream: bool = False) -> None:
+                self.is_stopped = True
+                ports.events.append("stream-stop")
+                ports.stream_stopped.set()
+
+        return PushOutput()
+
+    async def stop(self) -> None:
+        self.events.append("group-stop")
+
