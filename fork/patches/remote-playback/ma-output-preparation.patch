+    async def _assert_inflight_dynamic_refill_is_retired(self, *, resume: bool) -> None:
+        ports = QueuePorts()
+        ports.dynamic_gate = asyncio.Event()
+        ports.dynamic_ignore_cancel = True
+        ports.dynamic_results = [ports.available_track()]
+        pending = None
+        try:
+            self.assertTrue(ports.dynamic_results[0].available)
+            queue = await ports.start(dynamic=True)
+            task_id = f"fill_dynamic_tracks_{queue.queue_id}"
+            callback, args = ports.timers[task_id]
+            pending = ports.create_task(callback(*args), task_id=task_id)
+            await asyncio.wait_for(ports.dynamic_started.wait(), 0.3)
+            ports.http.status = 503
+            await asyncio.wait_for(ports.source_closed.wait(), 0.3)
+            if resume:
+                ports.http.status = 200
+                await ports.queues.resume(queue.queue_id)
+            ports.dynamic_gate.set()
+            await asyncio.wait_for(pending, 0.3)
+            self.assertEqual(
+                [item.name for item in ports.queues.items(queue.queue_id)], ["Audible track"]
+            )
+            self.assertEqual(ports.buffers[-1].cancelled, not resume)
+        finally:
+            ports.dynamic_gate.set()
+            if pending is not None:
+                await asyncio.gather(pending, return_exceptions=True)
+            await ports.close()
