+    async def close(self) -> None:
+        if self.recency_gate is not None:
+            self.recency_gate.set()
+        if self.dynamic_gate is not None:
+            self.dynamic_gate.set()
+        if self.source_close_gate is not None:
+            self.source_close_gate.set()
+        if self.stop_gate is not None:
+            self.stop_gate.set()
