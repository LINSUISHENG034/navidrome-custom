+                get_player_dsp_config=lambda player_id: SimpleNamespace(enabled=False),
+                get_raw_player_config_value=lambda player_id, key, default: default,
+            ),
+            streams=SimpleNamespace(
+                get_stream=ports.get_stream,
+                audio=SimpleNamespace(
+                    get_player_output_plan=lambda *args, **kwargs: SimpleNamespace(filter_params=[])
+                ),
+            ),
+        )
+        self.volume_level = 42
+        self.volume_muted = False
+        self._metadata_role = None
+        self._extra_attributes: dict[str, Any] = {}
